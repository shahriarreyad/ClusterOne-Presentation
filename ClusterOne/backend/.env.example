# ClusterOne Core Cluster Engine - configuration.
#
# Copy to .env (git-ignored) and edit. Every variable is read from the process
# environment too, and the environment wins over .env. Values shown are the
# defaults unless marked REQUIRED. NEVER commit real tokens or passwords.

# ---------------------------------------------------------------------------
# Scheduler mode
# ---------------------------------------------------------------------------
# false = development: a small built-in best-fit scheduler places jobs on nodes
#         that run node_agent.py, and job state lives in the local database.
# true  = Slurm is the source of truth: jobs are submitted/cancelled through
#         slurmrestd and their state, node, resources and exit code are synced
#         back from Slurm. The dev scheduler is not used.
CLUSTERONE_SLURM_ENABLED=false

# slurmrestd (the anchor node runs it bound to localhost, see Doc 07 section 4.1).
# SLURMRESTD_URL is accepted as an alias of CLUSTERONE_SLURMRESTD_URL.
CLUSTERONE_SLURMRESTD_URL=http://localhost:6820
CLUSTERONE_SLURMRESTD_VERSION=v0.0.40
CLUSTERONE_SLURMRESTD_TIMEOUT_SECONDS=10

# slurmrestd authenticates with Slurm JWTs: headers X-SLURM-USER-NAME and
# X-SLURM-USER-TOKEN. Create a token on the anchor node with
#     scontrol token username=clusterone lifespan=86400
# and give the backend EITHER the token file (preferred: it is re-read on every
# request, so rotating the file needs no restart; chmod 600, owned by the
# service user) OR the token itself. The user must be allowed to submit jobs
# for the accounts/QOS you use.
CLUSTERONE_SLURM_USER=clusterone
CLUSTERONE_SLURM_JWT_TOKEN_FILE=
#CLUSTERONE_SLURM_JWT_TOKEN=

# Partitions users may request (Doc 03/07 pilot layout) and the default.
CLUSTERONE_SLURM_PARTITIONS=gpu,interactive,teaching
CLUSTERONE_SLURM_DEFAULT_PARTITION=gpu

# At most one Slurm poll per this many seconds is triggered by API reads
# (protects slurmctld from a refreshing dashboard), and the background loop
# below also syncs. 0 disables the background loop (heartbeat sweeps then only
# happen when the API is called).
CLUSTERONE_SLURM_SYNC_TTL_SECONDS=5
CLUSTERONE_BACKGROUND_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite for development. For production use a server database, e.g.
#     postgresql+psycopg://clusterone:<password>@127.0.0.1/clusterone
# (install the driver yourself; DATABASE_URL is accepted as an alias.)
CLUSTERONE_DATABASE_URL=sqlite:///./clusterone.db

# ---------------------------------------------------------------------------
# Nodes
# ---------------------------------------------------------------------------
# A node is marked DOWN after this long without a heartbeat. Agents beat every
# ~1 s by default, so 30 s tolerates a few lost packets.
CLUSTERONE_HEARTBEAT_TIMEOUT_SECONDS=30

# Shown at the top of GET /api/v1/cluster/topology.
CLUSTERONE_MASTER_HOSTNAME=c1-anchor
CLUSTERONE_MASTER_IP=10.20.0.10

# Shared secret the node agents send as header X-Agent-Token (also
# CLUSTERONE_AGENT_TOKEN in the agent's environment or --token). Empty = no
# check; fine on an isolated dev LAN, set it on the cluster network.
CLUSTERONE_AGENT_TOKEN=

# ---------------------------------------------------------------------------
# Job limits and the container execution model
# ---------------------------------------------------------------------------
# Dev scheduler only: GPUs busier than this % are treated as in use by someone else and not offered to jobs.
CLUSTERONE_GPU_IDLE_THRESHOLD_PCT=10
CLUSTERONE_MAX_GPUS_PER_JOB=8
CLUSTERONE_MAX_CPUS_PER_JOB=128
CLUSTERONE_MAX_RAM_GB_PER_JOB=1024
CLUSTERONE_MAX_TIME_LIMIT_MINUTES=10080
CLUSTERONE_DEFAULT_TIME_LIMIT=01:00:00

# Jobs run inside an Apptainer image. A request may name a bare alias
# ("pytorch" -> <first image root>/pytorch.sif) or a .sif path under an image root.
CLUSTERONE_DEFAULT_IMAGE=/opt/apptainer/pytorch.sif
CLUSTERONE_IMAGE_ROOTS=/opt/apptainer
# docker:// / library:// / oras:// references are pulled at run time; leave
# off on a shared cluster unless you have decided how to vet them.
CLUSTERONE_ALLOW_REMOTE_IMAGES=false

# ---------------------------------------------------------------------------
# NFS / ZFS paths (Doc 04 section on storage)
# ---------------------------------------------------------------------------
# working_dir, dataset_path and output_dir in a job must be under one of these,
# and so must any Slurm log file the backend reads. Mount them on the anchor
# node (read-only is enough for datasets) so logs can be served.
CLUSTERONE_NFS_HOME_ROOT=/home
CLUSTERONE_NFS_PROJECTS_ROOT=/projects
CLUSTERONE_NFS_DATASETS_ROOT=/datasets
CLUSTERONE_SCRATCH_ROOT=/scratch
# Reject job paths that do not exist on the controller (only enable if the
# controller mounts all of the shares above).
CLUSTERONE_VALIDATE_PATHS_EXIST=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Application log level: DEBUG, INFO, WARNING, ERROR.
CLUSTERONE_LOG_LEVEL=INFO
# Dev-mode job output reported by node agents is written here (one file per job).
CLUSTERONE_LOG_DIR=./job-logs
# Job log API limits. The DB keeps only a bounded tail of dev-mode output.
CLUSTERONE_LOG_TAIL_DEFAULT_LINES=200
CLUSTERONE_LOG_TAIL_MAX_LINES=5000
CLUSTERONE_LOG_MAX_LINE_BYTES=8192
CLUSTERONE_LOG_SEARCH_MAX_RESULTS=1000
CLUSTERONE_LOG_DB_TAIL_BYTES=32768

# ---------------------------------------------------------------------------
# Prometheus (optional)
# ---------------------------------------------------------------------------
# When set, GET /nodes/{id}/metrics and /jobs/{id}/metrics add time series from
# node_exporter and dcgm-exporter. Unset = only the latest agent heartbeat.
#CLUSTERONE_PROMETHEUS_URL=http://localhost:9090
CLUSTERONE_PROMETHEUS_TIMEOUT_SECONDS=5
# Label that identifies a machine in your scrape config (host or IP, any port).
CLUSTERONE_PROMETHEUS_NODE_LABEL=instance

# ---------------------------------------------------------------------------
# Keycloak / OIDC (optional)
# ---------------------------------------------------------------------------
# When true, user-facing endpoints need "Authorization: Bearer <Keycloak access
# token>". The job owner is taken from the token (never the request body), users
# see and cancel only their own jobs, and members of the admin group see all.
# /health and /cluster/summary stay public (no per-user data). Node-agent
# endpoints use CLUSTERONE_AGENT_TOKEN instead.
CLUSTERONE_AUTH_ENABLED=false

# Without Keycloak, set one shared key so only people who know it can submit or cancel jobs (header
# "X-API-Key: <key>" or "Authorization: Bearer <key>"). The web UI asks for it under Settings; the CLI
# reads CLUSTERONE_API_KEY or --api-key. /health and /cluster/summary stay public. Strongly recommended
# whenever the controller is reachable by other PCs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#CLUSTERONE_API_KEY=
#CLUSTERONE_OIDC_ISSUER_URL=https://sso.example.edu/realms/clusterone
# Defaults to <issuer>/protocol/openid-connect/certs
#CLUSTERONE_OIDC_JWKS_URL=
#CLUSTERONE_OIDC_AUDIENCE=clusterone-api
# preferred_username must equal the POSIX username (Doc 07 section 4.3).
CLUSTERONE_OIDC_USERNAME_CLAIM=preferred_username
CLUSTERONE_OIDC_GROUPS_CLAIM=groups
CLUSTERONE_OIDC_ADMIN_GROUP=clusterone-admins

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API (the frontend). Comma separated.
CLUSTERONE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
