# ClusterOne SSH client config (N3). Append to ~/.ssh/config on your laptop.
# The anchor is the only campus-reachable host; compute nodes are reached through it.
# Names resolve via the anchor's DNS on the fabric, so ProxyJump uses the short name.

Host anchor01
    HostName anchor01.clusterone.internal
    User %u
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 30

Host gpu01 gpu02 gpu03 gpu04 gpu05
    HostName %h.clusterone.internal
    ProxyJump anchor01
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 30

# Inside the cluster (on the anchor): trust is via /etc/ssh/ssh_known_hosts (gen-known-hosts.sh)
# so StrictHostKeyChecking stays ON — never disable it to get past a prompt.
