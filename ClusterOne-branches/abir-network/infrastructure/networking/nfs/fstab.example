# Compute-node /etc/fstab entries for shared storage (N7). Export path is Shanto's — adjust.
# hard        : a network blip stalls I/O and resumes; `soft` would silently corrupt writes
# nfsvers=4.2 : matches nfs.conf.d (v3 off), needs only port 2049 through the firewall
# _netdev     : wait for the network; nofail: a down anchor must not block a node's boot
# rsize/wsize : 1 MiB suits the 9000-MTU fabric
anchor01.clusterone.internal:/srv/home  /home  nfs4  hard,nfsvers=4.2,proto=tcp,rsize=1048576,wsize=1048576,timeo=600,retrans=2,_netdev,nofail  0 0
